generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String            @id @default(uuid()) @db.VarChar(36)
  name         String            @db.VarChar(120)
  username     String            @unique @db.VarChar(80)
  passwordHash String            @db.VarChar(255)
  role         Role              @default(READER)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     Session[]
  bookmarks    Bookmark[]
  progress     ReadingProgress[]
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Series {
  id          String        @id @default(uuid()) @db.VarChar(36)
  title       String        @db.VarChar(160)
  description String        @db.Text
  genre       String        @db.VarChar(120)
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  books       Book[]

  @@index([status, sortOrder])
}

model Book {
  id                String            @id @default(uuid()) @db.VarChar(36)
  seriesId          String            @db.VarChar(36)
  title             String            @db.VarChar(160)
  subtitle          String?           @db.VarChar(200)
  description       String            @db.Text
  volumeNumber      Int
  sortOrder         Int               @default(0)
  status            PublishStatus     @default(DRAFT)
  coverPath         String?           @db.VarChar(255)
  coverMimeType     String?           @db.VarChar(80)
  coverOriginalName String?           @db.VarChar(255)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  series            Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  bookmarks         Bookmark[]
  progress          ReadingProgress[]

  @@unique([seriesId, volumeNumber])
  @@index([seriesId, status, sortOrder])
}

model Chapter {
  id        String            @id @default(uuid()) @db.VarChar(36)
  bookId    String            @db.VarChar(36)
  title     String            @db.VarChar(200)
  content   String            @db.LongText
  sortOrder Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress  ReadingProgress[]

  @@unique([bookId, sortOrder])
}

model Bookmark {
  userId    String   @db.VarChar(36)
  bookId    String   @db.VarChar(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

model ReadingProgress {
  userId    String   @db.VarChar(36)
  bookId    String   @db.VarChar(36)
  chapterId String   @db.VarChar(36)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([chapterId])
}
